      <aliases enabled='yes' />
      <column caption='Previous Month Active Users' datatype='integer' name='[Calculation_1076360334454652930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD([user_id]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Churned Users' datatype='integer' name='[Calculation_1076360334454882307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(COUNTD([user_id]), -1) &gt; COUNTD([user_id]) THEN&#13;&#10;LOOKUP(COUNTD([user_id]), -1) - COUNTD([user_id])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_1076360334455001092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(COUNTD([user_id]), -1) &gt; 0 THEN&#13;&#10;(LOOKUP(COUNTD([user_id]), -1) - COUNTD([user_id]))&#13;&#10;/ LOOKUP(COUNTD([user_id]), -1)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last Activity Date' datatype='datetime' name='[Calculation_1076360334456397831]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [user_id] : MAX([created_at]) }' />
      </column>
      <column caption='Days Since Last Activity' datatype='integer' name='[Calculation_1076360334456545288]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [Calculation_1076360334456397831],&#13;&#10;    [Calculation_1194579824731672576]&#13;&#10;)' />
      </column>
      <column caption='Churn Score' datatype='string' name='[Calculation_1076360334456688649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1076360334456545288] &gt; 30 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [Calculation_1076360334456545288] &gt; 14 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Max Activity Date' datatype='datetime' name='[Calculation_1194579824731672576]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([created_at]) }' />
      </column>
      <column caption='Revenue' datatype='integer' name='[Calculation_647392469821763584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_charge] = TRUE THEN [price] ELSE 0 END' />
      </column>
      <column caption='Avg/Trx' datatype='real' name='[Calculation_647392469823766530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_647392469821763584])/COUNT([__tableau_internal_object_id__].[df_fact.csv_B628161682B44C8A8A0706E4F8B5C517])' />
      </column>
      <column caption='Quality_Status_New' datatype='string' name='[Calculation_647392469877293060]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([channel]) = &quot;whatsapp&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;read&quot; THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;delivered&quot;, &quot;submitted&quot;) THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;rejected&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;email&quot; THEN&#13;&#10;    IF LOWER([message_status]) IN (&quot;opened&quot;, &quot;clicked&quot;) THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;delivered&quot;, &quot;processed&quot;, &quot;submitted&quot;) THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;failed&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;sms&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;sent&quot; THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;failed&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;call&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;answered&quot; THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;rna&quot;, &quot;failed&quot;) THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE &quot;unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Latency (Minutes)' datatype='integer' name='[Calculation_647392469884284934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;minute&apos;,&#13;&#10;    [created_at],&#13;&#10;    [received_timestamp]&#13;&#10;)' />
      </column>
      <column caption='Latency P90' datatype='real' name='[Calculation_647392469887897607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='PERCENTILE([Calculation_647392469884284934], 0.9)' />
      </column>
      <column caption='Active Days' datatype='integer' datatype-customized='true' name='[Created At (copy)_1076360334446387200]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(DATE([created_at]))' />
      </column>
      <column caption='Activity Month' datatype='datetime' name='[Created At (copy)_1076360334454349825]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[created_at])' />
      </column>
      <column caption='Delivery Rate' datatype='real' name='[Revenue (copy)_647392469825724419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [status_clean] = &apos;success&apos; THEN [transaction_id] END) / COUNT([transaction_id])' />
      </column>
