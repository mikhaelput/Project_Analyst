              <calculation class='tableau' formula='IF LOOKUP(COUNTD([user_id]), -1) &gt; 0 THEN&#13;&#10;(LOOKUP(COUNTD([user_id]), -1) - COUNTD([user_id]))&#13;&#10;/ LOOKUP(COUNTD([user_id]), -1)&#13;&#10;END'>
