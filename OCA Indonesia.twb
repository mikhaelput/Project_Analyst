              <calculation class='tableau' formula='IF LOWER([channel]) = &quot;whatsapp&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;read&quot; THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;delivered&quot;, &quot;submitted&quot;) THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;rejected&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;email&quot; THEN&#13;&#10;    IF LOWER([message_status]) IN (&quot;opened&quot;, &quot;clicked&quot;) THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;delivered&quot;, &quot;processed&quot;, &quot;submitted&quot;) THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;failed&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;sms&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;sent&quot; THEN &quot;delivered&quot;&#13;&#10;    ELSEIF LOWER([message_status]) = &quot;failed&quot; THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF LOWER([channel]) = &quot;call&quot; THEN&#13;&#10;    IF LOWER([message_status]) = &quot;answered&quot; THEN &quot;read&quot;&#13;&#10;    ELSEIF LOWER([message_status]) IN (&quot;rna&quot;, &quot;failed&quot;) THEN &quot;failed&quot;&#13;&#10;    ELSE &quot;unknown&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE &quot;unknown&quot;&#13;&#10;END' />
